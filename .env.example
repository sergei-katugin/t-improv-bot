# Bot tokens (from @BotFather)
ADMIN_BOT_TOKEN=your_admin_bot_token_here
PUBLIC_BOT_TOKEN=your_public_bot_token_here

# SQLite database path (Railway mounts a volume at /app/data)
DATABASE_URL=sqlite+aiosqlite:///./data/impro.db
WEBHOOK_SECRET=change-me-to-a-random-value

# Telegram channel where public announcements are posted (e.g. @my_impro_channel)
ANNOUNCEMENT_CHANNEL_ID=@your_channel

# Comma-separated Telegram user IDs of super-admins (no spaces)
ADMIN_IDS=123456789,987654321

