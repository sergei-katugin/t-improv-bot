# Bot tokens (from @BotFather)
ADMIN_BOT_TOKEN=your_admin_bot_token_here
PUBLIC_BOT_TOKEN=your_public_bot_token_here
PUBLIC_BOT_USERNAME=ImprovCypEventBot
ADMIN_BOT_USERNAME=ImprovCypBot
ADMIN_BOT_DISPLAY_NAME=T·IMPRO

# External Postgres URL. Keep the real credential only in Render/local .env.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
WEBHOOK_SECRET=change-me-to-a-random-value

# Telegram channel where public announcements are posted (e.g. @my_impro_channel)
ANNOUNCEMENT_CHANNEL_ID=@your_channel

# Comma-separated Telegram user IDs of super-admins (no spaces)
ADMIN_IDS=123456789,987654321
INVITE_TTL_HOURS=24
APP_TIMEZONE=Europe/Nicosia
REMINDER_HOUR_LOCAL=9
MAX_CONCURRENT_UPDATES=20
# Optional private admin chat for unhandled-error alerts
# ERROR_ALERT_CHAT_ID=123456789
